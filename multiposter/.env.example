# --- Canva (facultatif) : importer tes derniers designs dans un post ---
# https://www.canva.com/developers/integrations → Créer une intégration
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Brouillons automatiques : vérification toutes les N minutes, et délai sans modification
# avant de considérer un design comme terminé.
CANVA_WATCH_MINUTES=10
CANVA_STABLE_MINUTES=10

# --- Alertes (facultatif, gratuit) ---
# Webhook Discord (Paramètres du salon → Intégrations → Webhooks), Slack, ou un sujet ntfy.sh.
# Prévient en cas d'échec de publication et quand un brouillon Canva est prêt.
ALERT_WEBHOOK_URL=

# --- Nettoyage des médias ---
# Les médias des posts publiés depuis plus de N jours sont supprimés du disque.
MEDIA_RETENTION_DAYS=90

# --- Obligatoire ---
# URL publique HTTPS où l'app est joignable (sans slash final). Elle sert aux retours OAuth,
# et Instagram/Facebook/Threads y téléchargent tes médias.
PUBLIC_URL=https://post.mondomaine.fr
# Mot de passe pour se connecter à l'interface.
ADMIN_PASSWORD=change-moi
# Clé secrète de 32 caractères minimum (chiffrement des tokens, cookies).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Adresse publique des seuls médias, pour Instagram et Threads qui viennent les télécharger
# (facultatif ; par défaut PUBLIC_URL). L'interface reste alors uniquement sur ton PC.
MEDIA_PUBLIC_URL=

# Tailscale : ouvert automatiquement (/oauth et /media) s'il est installé. « off » pour désactiver.
TAILSCALE=

PORT=3210
DATA_DIR=./data
MAX_UPLOAD_MB=1024

# --- Réseaux (remplis seulement ceux que tu utilises) ---
# Facebook + Instagram (une seule app Meta) — https://developers.facebook.com/apps
META_APP_ID=
META_APP_SECRET=

# Threads (cas d'usage "Threads API" de l'app Meta, identifiants distincts)
THREADS_APP_ID=
THREADS_APP_SECRET=

# X — https://developer.x.com (OAuth 2.0, type "Web App / confidential client")
X_CLIENT_ID=
X_CLIENT_SECRET=
# 280 par défaut ; mets 25000 si ton compte X est Premium.
X_MAX_CHARS=280

# YouTube — https://console.cloud.google.com (OAuth client "Application Web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# public | unlisted | private
YOUTUBE_PRIVACY=public
# 20 = Jeux vidéo
YOUTUBE_CATEGORY_ID=20

# TikTok — https://developers.tiktok.com (Login Kit + Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE
