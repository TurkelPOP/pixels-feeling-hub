# Copiez ce fichier en `.env` (local) ou renseignez ces variables chez l'hébergeur. Ne commitez jamais `.env`.

# --- Twitch (connexion, diffusions, planning) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Chaîne affichée (défaut : turkelpop)
TWITCH_CHANNEL=turkelpop

# --- YouTube (facultatif : sans clé, le flux RSS de la playlist est utilisé) ---
YOUTUBE_API_KEY=

# --- Synchronisation entre appareils ---
# Secret qui signe le cookie de session : au moins 32 caractères, gardé secret. Sans lui, la synchronisation est désactivée.
# Générer : node -e "console.log(require('crypto').randomBytes(36).toString('hex'))"
SESSION_SECRET=
# Fichier de la base SQLite (défaut : ./data/sync.sqlite). En production, choisissez un dossier hors du dossier déployé
# pour qu'un nouveau déploiement ne l'écrase pas. Exige Node 22.13 ou plus (module node:sqlite).
SYNC_DB_PATH=

# --- Adresse publique du site ---
# URL publique, sans slash final. Lue au RUNTIME par le serveur (retour OAuth Twitch, contrôle d'origine).
SITE_URL=
# La même URL doit être définie AU BUILD : elle est intégrée au code (canonical, og:url, sitemap, robots.txt).
VITE_SITE_URL=
